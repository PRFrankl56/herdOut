generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Request {
  id          String   @id @default(cuid())
  name        String
  phone       String
  address     String
  lat         Float?
  lng         Float?
  situation   String?
  evacuationScope String @default("own")
  trailerType     String
  createdAt       DateTime @default(now())
  animals     Animal[]
}

model Animal {
  id           String  @id @default(cuid())
  species      String
  count        Int
  specialNeeds String?
  request      Request @relation(fields: [requestId], references: [id])
  requestId    String
}

model Transporter {
  id              String   @id @default(cuid())
  name            String
  phone           String
  address         String
  lat             Float?
  lng             Float?
  stallCount      Int
  rigLengthFt     String
  trailerTypes    String
  driveCapability String
  livestockTypes  String
  maxDistance      String
  availableNow    Boolean
  availableInHours Int?
  notes           String?
  createdAt       DateTime @default(now())
}
