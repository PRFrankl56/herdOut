generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth models ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  address       String?
  role          String    @default("owner") // owner, transporter, both
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  animals       Animal[]
  transporterProfile TransporterProfile?
  transporter   Transporter?
  requests      Request[]
  pushSubscriptions PushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ── User animal profiles ─────────────────────────────────────────

model Animal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  species      String   // horse, cattle, goat, sheep, pig, other
  breed        String?
  color        String?
  markings     String?  // distinctive markings description
  weightClass  String?  // pony, light, warmblood, draft
  photoUrl     String?  // Vercel Blob URL
  specialNeeds String?
  vetName      String?
  vetPhone     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Transporter profile ──────────────────────────────────────────

model TransporterProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  stallCount    Int
  rigLengthFt   String
  trailerTypes  String
  livestockTypes String
  maxDistance   String
  notes         String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Evacuation request models (existing) ─────────────────────────

model Request {
  id              String   @id @default(cuid())
  userId          String?
  name            String
  phone           String
  address         String
  lat             Float?
  lng             Float?
  situation       String?
  evacuationScope String   @default("own")
  trailerType     String
  status          String   @default("unmatched") // unmatched, queued, matched, confirmed, completed, cancelled
  createdAt       DateTime @default(now())
  animals         RequestAnimal[]
  matches         Match[]
  user            User?    @relation(fields: [userId], references: [id])
}

model RequestAnimal {
  id           String  @id @default(cuid())
  species      String
  count        Int
  specialNeeds String?
  request      Request @relation(fields: [requestId], references: [id])
  requestId    String
}

model Transporter {
  id              String   @id @default(cuid())
  userId          String?  @unique
  name            String
  phone           String
  address         String
  lat             Float?
  lng             Float?
  stallCount      Int
  rigLengthFt     String
  trailerTypes    String
  driveCapability String
  livestockTypes  String
  maxDistance      String
  availableNow    Boolean
  availableInHours Int?
  availability    String   @default("available") // available, unavailable
  notes           String?
  createdAt       DateTime @default(now())
  matches         Match[]
  user            User?    @relation(fields: [userId], references: [id])
}

model Match {
  id            String    @id @default(cuid())
  requestId     String
  transporterId String
  status        String    @default("pending") // pending, accepted, rejected, completed, cancelled
  notifiedAt    DateTime?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  request       Request      @relation(fields: [requestId], references: [id])
  transporter   Transporter  @relation(fields: [transporterId], references: [id])
}


model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model FireSnapshot {
  id            String   @id @default(cuid())
  incidentId    String
  title         String
  containmentPct Int?
  cachedAt      DateTime @default(now())

  @@index([incidentId, cachedAt])
}
