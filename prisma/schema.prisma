generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id          String   @id @default(cuid())
  name        String
  phone       String
  address     String
  lat         Float?
  lng         Float?
  situation   String?
  evacuationScope String @default("own")
  trailerType     String
  status          String @default("unmatched") // unmatched, queued, matched, confirmed, completed
  createdAt       DateTime @default(now())
  animals     Animal[]
  matches     Match[]
}

model Animal {
  id           String  @id @default(cuid())
  species      String
  count        Int
  specialNeeds String?
  request      Request @relation(fields: [requestId], references: [id])
  requestId    String
}

model Transporter {
  id              String   @id @default(cuid())
  name            String
  phone           String
  address         String
  lat             Float?
  lng             Float?
  stallCount      Int
  rigLengthFt     String
  trailerTypes    String
  driveCapability String
  livestockTypes  String
  maxDistance      String
  availableNow    Boolean
  availableInHours Int?
  availability    String   @default("available") // available, in_progress
  notes           String?
  createdAt       DateTime @default(now())
  matches         Match[]
}

model Match {
  id            String    @id @default(cuid())
  requestId     String
  transporterId String
  status        String    @default("pending") // pending, accepted, rejected, completed, cancelled
  notifiedAt    DateTime?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  request       Request      @relation(fields: [requestId], references: [id])
  transporter   Transporter  @relation(fields: [transporterId], references: [id])
}
